# 이 파일을 .env로 복사해서 값을 채웁니다. (.env는 커밋하지 않음)

# ── 클라이언트에 노출되는 값 (VITE_ 접두사) ──
VITE_DISCORD_CLIENT_ID=

# ── 서버 전용 비밀 값 ──
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# 슬래시 명령어를 즉시 등록할 테스트 서버 ID (개발자 모드 → 서버 우클릭 → ID 복사)
DEV_GUILD_ID=

# 서버 포트
PORT=3001

# ── Supabase (M3 후반, 업로드 기능부터 사용) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
