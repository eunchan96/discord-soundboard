# 이 파일을 .env로 복사해서 값을 채웁니다. (.env는 커밋하지 않음)

# ── 클라이언트에 노출되는 값 (VITE_ 접두사) ──
VITE_DISCORD_CLIENT_ID=

# ── 서버 전용 비밀 값 ──
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# (선택) 테스트 서버 ID. 시작 시 PoC 때 등록한 /sound-test 명령어를 정리하는 데만 씁니다.
DEV_GUILD_ID=

# 서버 포트
PORT=3001

# ── Supabase (필수) ──
# URL은 프로젝트 고정값. 키는 대시보드 → Project Settings → API Keys의 Secret key (서버 전용, 절대 VITE_ 붙이지 말 것)
SUPABASE_URL=https://cvmletmvpnkcfbjkdnpw.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── 배포 서버에서만 (로컬 개발에서는 비워 둠) ──
# HTTPS 주소. DuckDNS 예: acesound.duckdns.org  (https:// 없이)
DOMAIN=
